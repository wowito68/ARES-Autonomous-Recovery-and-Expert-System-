[Unit]
Description=ARES privileged tool broker socket
Requires=ares-audit.socket ares-consent-agent.socket
After=ares-audit.socket ares-consent-agent.socket

[Socket]
ListenStream=/run/ares/sockets/broker.sock
SocketUser=ares-broker
SocketGroup=ares-api
SocketMode=0660
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
