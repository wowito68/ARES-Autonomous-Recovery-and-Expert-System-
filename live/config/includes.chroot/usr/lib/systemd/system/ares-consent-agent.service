[Unit]
Description=ARES trusted local consent agent
Requires=ares-audit.socket
After=ares-audit.socket systemd-user-sessions.service

[Service]
Type=simple
User=ares-consent
Group=ares-consent
Environment=PYTHONPATH=/opt/ares/backend/src
ExecStart=/usr/bin/python3 -m ares.runtime.entrypoints consent
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
ReadWritePaths=/run/ares/sockets
IPAddressDeny=any
