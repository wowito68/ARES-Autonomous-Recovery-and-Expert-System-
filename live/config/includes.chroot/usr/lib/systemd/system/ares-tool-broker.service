[Unit]
Description=ARES privileged tool broker
Requires=ares-audit.socket ares-consent-agent.socket
After=ares-audit.socket ares-consent-agent.socket

[Service]
Type=simple
User=root
Group=ares-broker
Environment=PYTHONPATH=/opt/ares/backend/src
ExecStart=/usr/bin/python3 -m ares.runtime.entrypoints broker
Restart=on-failure
RestartSec=2s
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
ReadWritePaths=/run/ares/sockets /var/lib/ares/broker /var/lib/ares/backups /var/lib/ares/storage-images /mnt /media /run/media
IPAddressDeny=any
