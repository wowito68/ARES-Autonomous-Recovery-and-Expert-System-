#!/bin/sh
set -eu

mkdir -p /run/ares
trust=$(jq -r '.trust // "UNKNOWN"' /run/ares/integrity.json)
mode=$(cat /run/ares/mode)
printf 'ARES_BOOT_READY mode=%s trust=%s\n' "${mode}" "${trust}" > /run/ares/boot-ready
chmod 0644 /run/ares/boot-ready

if [ -c /dev/ttyS0 ]; then
    timeout 2 sh -c 'cat /run/ares/boot-ready > /dev/ttyS0' || true
fi
