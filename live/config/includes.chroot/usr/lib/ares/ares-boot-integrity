#!/bin/sh
set -eu

# Boot integrity is on the critical path. Keep it independent of the Python
# interpreter so it remains bounded on slow recovery hardware and under TCG.
runtime_root=${ARES_RUNTIME_ROOT:-/run/ares}
efi_root=${ARES_EFI_ROOT:-/sys/firmware/efi}
dmsetup_binary=${ARES_DMSETUP:-/usr/sbin/dmsetup}
output=${runtime_root}/integrity.json
temporary=${output}.tmp.$$
trap 'rm -f -- "${temporary}"' EXIT HUP INT TERM
umask 022

secure_boot=unavailable
firmware=bios
if [ -d "${efi_root}" ]; then
    firmware=uefi
    secure_boot=unknown
    for variable in "${efi_root}"/efivars/SecureBoot-*; do
        [ -r "${variable}" ] || continue
        value=$(od -An -t u1 -j 4 -N 1 "${variable}" 2>/dev/null | tr -d ' ')
        case "${value}" in
            1) secure_boot=enabled ;;
            0) secure_boot=disabled ;;
            *) secure_boot=unknown ;;
        esac
        break
    done
fi

verity=inactive
if verity_devices=$(timeout 3 "${dmsetup_binary}" ls --target verity 2>/dev/null); then
    case "${verity_devices}" in
        ''|*"No devices found"*) verity=inactive ;;
        *) verity=active ;;
    esac
else
    verity=unknown
fi

integrity_failed=false
if [ "${verity}" != active ]; then
    trust=FAILED
    integrity_failed=true
elif [ "${firmware}" = bios ]; then
    trust=UNAVAILABLE
elif [ "${secure_boot}" = disabled ]; then
    trust=DISABLED
elif [ "${secure_boot}" = enabled ]; then
    # Debian shim/GRUB/kernel are signed, but this development image does not
    # yet authenticate initrd, cmdline and the verity root hash as one UKI.
    trust=ENFORCED_PARTIAL
else
    trust=UNKNOWN
fi

mkdir -p "${runtime_root}"
printf '%s\n' \
    "{\"schema_version\":1,\"firmware\":\"${firmware}\",\"secure_boot\":\"${secure_boot}\",\"dm_verity\":\"${verity}\",\"trust\":\"${trust}\",\"full_chain\":false}" \
    > "${temporary}"
chmod 0644 "${temporary}"
sync -f "${temporary}"
mv -f -- "${temporary}" "${output}"
trap - EXIT HUP INT TERM

if [ "${integrity_failed}" = true ]; then
    exit 1
fi
