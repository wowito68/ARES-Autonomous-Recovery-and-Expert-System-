#!/bin/sh
set -eu

# Boot integrity is on the critical path. Keep it independent of the Python
# interpreter so it remains bounded on slow recovery hardware and under TCG.
runtime_root=${ARES_RUNTIME_ROOT:-/run/ares}
efi_root=${ARES_EFI_ROOT:-/sys/firmware/efi}
proc_mounts=${ARES_PROC_MOUNTS:-/proc/mounts}
sys_block_root=${ARES_SYS_BLOCK_ROOT:-/sys/block}
output=${runtime_root}/integrity.json
temporary=${output}.tmp.$$
trap 'rm -f -- "${temporary}"' EXIT HUP INT TERM
umask 022

secure_boot=unavailable
firmware=bios
if [ -d "${efi_root}" ]; then
    firmware=uefi
    secure_boot=unknown
    for variable in "${efi_root}"/efivars/SecureBoot-*; do
        [ -r "${variable}" ] || continue
        value=$(od -An -t u1 -j 4 -N 1 "${variable}" 2>/dev/null | tr -d ' ')
        case "${value}" in
            1) secure_boot=enabled ;;
            0) secure_boot=disabled ;;
            *) secure_boot=unknown ;;
        esac
        break
    done
fi

verity=inactive
verity_source=
verity_type=
verity_options=
while IFS=' ' read -r source target filesystem options remainder; do
    : "${remainder:=}"
    if [ "${target}" = /run/live/rootfs/filesystem.squashfs ]; then
        verity_source=${source}
        verity_type=${filesystem}
        verity_options=${options}
        break
    fi
done < "${proc_mounts}"

case "${verity_source}" in
    /dev/mapper/*-verity)
        mapper_name=${verity_source#/dev/mapper/}
        verity=unknown
        for dm_directory in "${sys_block_root}"/dm-*; do
            [ -r "${dm_directory}/dm/name" ] || continue
            IFS= read -r candidate_name < "${dm_directory}/dm/name" || continue
            [ "${candidate_name}" = "${mapper_name}" ] || continue
            IFS= read -r candidate_uuid < "${dm_directory}/dm/uuid" || continue
            case "${candidate_uuid}" in
                CRYPT-VERITY-*)
                    case ",${verity_options}," in
                        *,ro,*)
                            if [ "${verity_type}" = squashfs ]; then
                                verity=active
                            fi
                            ;;
                    esac
                    ;;
            esac
            break
        done
        ;;
esac

integrity_failed=false
if [ "${verity}" != active ]; then
    trust=FAILED
    integrity_failed=true
elif [ "${firmware}" = bios ]; then
    trust=UNAVAILABLE
elif [ "${secure_boot}" = disabled ]; then
    trust=DISABLED
elif [ "${secure_boot}" = enabled ]; then
    # Debian shim/GRUB/kernel are signed, but this development image does not
    # yet authenticate initrd, cmdline and the verity root hash as one UKI.
    trust=ENFORCED_PARTIAL
else
    trust=UNKNOWN
fi

mkdir -p "${runtime_root}"
printf '%s\n' \
    "{\"schema_version\":1,\"firmware\":\"${firmware}\",\"secure_boot\":\"${secure_boot}\",\"dm_verity\":\"${verity}\",\"trust\":\"${trust}\",\"full_chain\":false}" \
    > "${temporary}"
chmod 0644 "${temporary}"
mv -f -- "${temporary}" "${output}"
trap - EXIT HUP INT TERM

if [ "${integrity_failed}" = true ]; then
    exit 1
fi
