#!/bin/sh
set -eu

systemd-sysusers /usr/lib/sysusers.d/ares.conf
systemd-tmpfiles --create /usr/lib/tmpfiles.d/ares.conf

systemctl enable ares.target
systemctl enable ares-boot-ready.service
systemctl enable ares-hardware-enrichment.timer
systemctl enable lightdm.service
systemctl enable nftables.service
systemctl set-default graphical.target

for unit in \
    NetworkManager-wait-online.service \
    grub-common.service; do
    systemctl disable "${unit}" >/dev/null 2>&1 || true
done

for unit in \
    apt-daily.service \
    apt-daily.timer \
    apt-daily-upgrade.service \
    apt-daily-upgrade.timer \
    bluetooth.service \
    e2scrub_all.service \
    e2scrub_all.timer \
    fwupd.service \
    fwupd-refresh.service \
    fwupd-refresh.timer \
    lvm2-monitor.service \
    lm-sensors.service \
    mdmonitor.service \
    ModemManager.service \
    nvmefc-boot-connections.service \
    nvmf-autoconnect.service \
    smartmontools.service \
    systemd-timesyncd.service \
    udisks2.service \
    xfs_scrub_all.service \
    xfs_scrub_all.timer; do
    ln -sf /dev/null "/etc/systemd/system/${unit}"
done

for unit in \
    cron.service \
    console-setup.service \
    e2scrub_reap.service \
    fstrim.timer \
    keyboard-setup.service \
    nvmf-connect-nbft.service \
    nvmf-connect.target \
    nvmf-connect@.service \
    smartd.service \
    systemd-hibernate-clear.service \
    systemd-pstore.service \
    sleep.target \
    suspend.target \
    hibernate.target \
    hybrid-sleep.target \
    suspend-then-hibernate.target; do
    ln -sf /dev/null "/etc/systemd/system/${unit}"
done

for rule in \
    65-persistent-net-nbft.rules \
    70-nvmf-autoconnect.rules \
    70-nvmf-keys.rules \
    71-nvmf-netapp.rules; do
    ln -sf /dev/null "/etc/udev/rules.d/${rule}"
done
